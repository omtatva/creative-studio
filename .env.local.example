# Firebase client config (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Studio — server-side only, never NEXT_PUBLIC_. Shared fallback
# used only when a workspace hasn't configured its own key in
# Settings > AI (see SETTINGS_ENCRYPTION_KEY below). Read exclusively
# by src/app/api/ai-studio/generate/route.ts; never sent to the
# client, never stored in Firestore. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional shared fallback NVIDIA NIM API key (build.nvidia.com), same
# role as GEMINI_API_KEY above but for the NVIDIA provider.
NVIDIA_API_KEY=

# Server-side only, never NEXT_PUBLIC_. Encrypts workspace-supplied
# secrets (currently: per-workspace Gemini keys saved in Settings >
# AI) before they're written to Firestore — see
# src/lib/server/secretCrypto.ts. Must be a base64-encoded 32-byte
# (256-bit) key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this key after keys have been saved makes them
# undecryptable — treat it like any other production secret (back it
# up, don't rotate casually).
SETTINGS_ENCRYPTION_KEY=

# Gmail OAuth (workspace-invitation emails) — server-side only, never
# NEXT_PUBLIC_. Each user connects their own Gmail account in
# Settings > Users; invitations are then sent via the Gmail API from
# that user's own address instead of a shared sender — see
# src/app/api/auth/google/*, src/lib/server/gmailClient.ts, and
# src/app/api/invites/send/route.ts. Create this OAuth Web Client at
# https://console.cloud.google.com/apis/credentials with the
# https://www.googleapis.com/auth/gmail.send scope, an Internal
# audience, and this exact redirect URI registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://otdfeedo.omtatvadigitals.com/api/auth/google/callback

# Firebase Admin credentials — server-side only, never NEXT_PUBLIC_.
# Needed to verify Firebase ID tokens and read/write the
# gmail_connections collection from the server (see
# src/lib/server/firebaseAdmin.ts) with real privilege, bypassing
# Firestore security rules (which deny ALL direct client access to
# that collection). In Firebase App Hosting this can usually be left
# unset — Application Default Credentials are provided automatically
# there. For local development, generate a service account key
# (Firebase Console > Project Settings > Service Accounts > Generate
# new private key) and set this to its JSON contents, base64-encoded:
#   node -e "console.log(require('fs').readFileSync('service-account.json').toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_KEY=
