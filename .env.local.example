# Firebase client config (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Studio — server-side only, never NEXT_PUBLIC_. Shared fallback
# used only when a workspace hasn't configured its own key in
# Settings > AI (see SETTINGS_ENCRYPTION_KEY below). Read exclusively
# by src/app/api/ai-studio/generate/route.ts; never sent to the
# client, never stored in Firestore. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional shared fallback NVIDIA NIM API key (build.nvidia.com), same
# role as GEMINI_API_KEY above but for the NVIDIA provider.
NVIDIA_API_KEY=

# Server-side only, never NEXT_PUBLIC_. Encrypts workspace-supplied
# secrets (currently: per-workspace Gemini keys saved in Settings >
# AI) before they're written to Firestore — see
# src/lib/server/secretCrypto.ts. Must be a base64-encoded 32-byte
# (256-bit) key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this key after keys have been saved makes them
# undecryptable — treat it like any other production secret (back it
# up, don't rotate casually).
SETTINGS_ENCRYPTION_KEY=

# Resend — server-side only, never NEXT_PUBLIC_. Read exclusively by
# src/app/api/invites/send/route.ts to send workspace-invitation
# emails; never sent to the client, never stored in Firestore. Get a
# key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: sender identity for invitation emails. Defaults to
# Resend's shared test sender (onboarding@resend.dev), which only
# delivers to the email address on your own Resend account until you
# verify a custom domain at https://resend.com/domains.
RESEND_FROM_EMAIL="Omtatva Digitals <onboarding@resend.dev>"
