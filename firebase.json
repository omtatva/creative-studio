{
  "firestore": {
    "rules": "firebase-config/firestore.rules",
    "indexes": "firebase-config/firestore.indexes.json",
    "database": "(default)"
  },
  "storage": {
    "target": "rules",
    "rules": "firebase-config/storage.rules",
    "bucket": "creative-studio-176c0.firebasestorage.app"
  },
  "apphosting": {
    "backendId": "creative-studio-backend",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ],
    "alwaysDeployFromSource": false
  }
}
