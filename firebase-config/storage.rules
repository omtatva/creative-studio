rules_version = '2';

// Mirrors the Firestore tenancy model: every object lives under
// workspaces/{workspaceId}/... Historically every sub-path here has
// shared one blanket "any signed-in user" rule, which is loose but
// matched Firestore's own (equally loose, now tightened) posture at
// the time.
//
// `branding/**` is the one sub-path tightened here to real per-
// workspace access, matching the Settings > Branding logo feature:
// only members of THAT workspace may read a workspace's branding
// assets, and only that workspace's owner/admin (or the platform
// Super Admin — see firestore.rules' isSuperAdmin(), same
// platformRole-field check) may write them. Everything else keeps its
// existing behavior unchanged — this is deliberately a single match
// block with the resource-type segment captured as a variable
// (`resourceType`) and branched on inline, NOT two overlapping
// `match` blocks, because Storage (like Firestore) rules do not
// "more-specific-wins" across independently declared sibling
// matches — a broad catch-all matching the same path would otherwise
// silently coexist with a tighter one via OR, undermining it.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Same check as firestore.rules' isSuperAdmin() — see that
    // function's doc comment for why this is an OR of the token-claim
    // check and the `platformRole` field, not just the field alone.
    function isSuperAdmin() {
      return isSignedIn()
        && (
          (request.auth.token.email == 'itsupport@omtatvadigitals.com' && request.auth.token.email_verified == true)
          || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
              && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('platformRole', null) == 'super_admin')
        );
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/members/$(workspaceId + '_' + request.auth.uid));
    }

    function workspaceMemberRole(workspaceId) {
      return firestore.get(/databases/(default)/documents/members/$(workspaceId + '_' + request.auth.uid)).data.role;
    }

    function isWorkspaceAdmin(workspaceId) {
      return isWorkspaceMember(workspaceId) && workspaceMemberRole(workspaceId) in ['owner', 'admin'];
    }

    match /workspaces/{workspaceId}/{resourceType}/{allPaths=**} {
      allow read: if resourceType == 'branding'
        ? (isWorkspaceMember(workspaceId) || isSuperAdmin())
        : isSignedIn();
      allow write: if resourceType == 'branding'
        ? (isWorkspaceAdmin(workspaceId) || isSuperAdmin())
        : isSignedIn();
    }
  }
}
