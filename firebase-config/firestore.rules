rules_version = '2';

// Multi-tenant isolation model:
//  - `users/{uid}` — only the owning user can read/write their own profile.
//  - `workspaces/{workspaceId}` — readable by any member of that workspace;
//    writable only by the owner (initial creation happens via a
//    transaction from a trusted client action).
//  - `members/{workspaceId}_{uid}` — readable by members of that
//    workspace; writable by workspace owners/admins.
//  - `settings/{workspaceId}` — same access shape as workspace doc.
//  - `workspaces/{workspaceId}/activity_logs/**`,
//    `workspaces/{workspaceId}/notifications/{uid}/**` — scoped
//    subcollections, inherit workspace membership checks.
//  - `workspace_invites/{inviteId}` — owner/admin create/manage;
//    invitee (matched by verified auth email, not workspace
//    membership) may read and accept only their own invite.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/members/$(workspaceId + '_' + request.auth.uid));
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // Real role enum for this app is owner|admin|member|viewer (see
    // MemberRole in types/workspace.types.ts) — used to restrict
    // project creation to non-viewer roles below.
    function memberRole(workspaceId) {
      return get(/databases/$(database)/documents/members/$(workspaceId + '_' + request.auth.uid)).data.role;
    }

    function isWorkspaceMemberWithRole(workspaceId, roles) {
      return isWorkspaceMember(workspaceId) && memberRole(workspaceId) in roles;
    }

    // Backs the "accept invite" membership-create path below: proves a
    // brand-new membership doc corresponds to a real, still-pending
    // invite addressed to the caller's own VERIFIED auth email (not
    // anything the client merely claims), for exactly the role that
    // invite grants — so a user can only ever join via an invite that
    // was actually sent to them.
    function isPendingInviteMatch(inviteId, data) {
      let invite = get(/databases/$(database)/documents/workspace_invites/$(inviteId)).data;
      return invite.workspaceId == data.workspaceId
        && invite.email == request.auth.token.email
        && invite.role == data.role
        && invite.status == 'pending';
    }

    function isValidInviteAccept(data) {
      return ('sourceInviteId' in data)
        && data.sourceInviteId is string
        && isPendingInviteMatch(data.sourceInviteId, data);
    }

    // The platform's Super Admin — a PLATFORM-LEVEL role, completely
    // separate from any workspace's owner/admin (see the two-level
    // administration model in lib/constants/itSupport.ts). TRUE if
    // EITHER:
    //   (a) `platformRole` on the caller's own `users/{uid}` doc is
    //       "super_admin" — which only firebase-admin can ever write
    //       (see that same doc's create/update rules below), never a
    //       value the client supplied directly. This is what makes a
    //       SECOND Super Admin addable later with zero code changes
    //       (just set the field in the Firebase Console).
    //   (b) the caller's own server-verified ID token email/
    //       email_verified claims match the one designated Super Admin
    //       account — the exact same non-forgeable check this app has
    //       always used (a workspace owner cannot fake Firebase's own
    //       token claims by calling the client SDK any more than they
    //       could fake `platformRole`). Kept as a standing fallback,
    //       not a stopgap: rules and application code deploy on
    //       independent schedules, so isSuperAdmin() must never have a
    //       hard dependency on the self-healing bootstrap in
    //       verifySuperAdminAuth (firebaseAdmin.ts) having already run
    //       for this account.
    function isSuperAdmin() {
      return isSignedIn()
        && (
          (request.auth.token.email == 'itsupport@omtatvadigitals.com' && request.auth.token.email_verified == true)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('platformRole', null) == 'super_admin')
        );
    }

    // Real, queryable project-level access-control record — see
    // ProjectMembership's doc comment in types/project.types.ts.
    // Workspace membership alone no longer implies project visibility;
    // this (plus the owner/admin/Super-Admin bypasses below) is what
    // does.
    function isProjectMember(projectId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/project_members/$(projectId + '_' + request.auth.uid));
    }

    function projectMemberRole(projectId) {
      return get(/databases/$(database)/documents/project_members/$(projectId + '_' + request.auth.uid)).data.role;
    }

    // Project-level owner/manager — distinct from WORKSPACE owner/admin
    // (isWorkspaceMemberWithRole). Lets a project owner/manager who
    // isn't a workspace admin still manage their own project's
    // team/settings (see ProjectRole in types/project.types.ts —
    // owner/manager/editor/viewer; owner+manager can manage, matching
    // the existing Project Members tab's intent).
    function isProjectAdmin(projectId) {
      return isProjectMember(projectId) && projectMemberRole(projectId) in ['owner', 'manager'];
    }

    // The read gate for every project-SCOPED resource (the project
    // itself, its tasks/board/files/reviews/stages and their
    // subcollections): workspace owner/admin, Super Admin, or an
    // explicit project_members record — ANY role, including viewer.
    // A plain workspace member/viewer with no project_members doc for
    // this project sees NOTHING here — this is the actual fix for
    // "workspace membership must not automatically grant project
    // visibility."
    function canAccessProject(workspaceId, projectId) {
      return isSuperAdmin()
        || isWorkspaceMemberWithRole(workspaceId, ['owner', 'admin'])
        || isProjectMember(projectId);
    }

    // The write gate for ordinary project WORK (tasks/board/files/
    // stages create/update/delete): same as canAccessProject except a
    // project-level 'viewer' is excluded — read-only per ProjectRole's
    // doc comment. Workspace owner/admin and Super Admin are unaffected
    // (they bypass project role entirely, same as canAccessProject).
    function canWriteProject(workspaceId, projectId) {
      return isSuperAdmin()
        || isWorkspaceMemberWithRole(workspaceId, ['owner', 'admin'])
        || (isProjectMember(projectId) && projectMemberRole(projectId) != 'viewer');
    }

    // The write/manage gate for project-level administration (project
    // settings, and project_members itself): workspace owner/admin,
    // Super Admin, or a project-level owner/manager.
    function canManageProject(workspaceId, projectId) {
      return isSuperAdmin()
        || isWorkspaceMemberWithRole(workspaceId, ['owner', 'admin'])
        || isProjectAdmin(projectId);
    }

    // Google-Sheets-style link sharing for ONE file at a time (see
    // FileShareSettings in types/file.types.ts) — deliberately separate
    // from canAccessProject/canWriteProject above: a shared file grants
    // access to THAT FILE (and its own comments/annotations) only, never
    // to the rest of the project, and never to write actions beyond
    // adding a comment/annotation (no new versions, no delete, no
    // settings). `fileData` is the plain map from a file doc's `.data`
    // (either `resource.data` on the file itself, or a parent `get()...
    // .data` from the comments/annotations subcollections below) — never
    // `resource` itself, so this is always null-safe against a
    // not-yet-existing document the same way the rest of this file
    // guards `resource != null` before touching `resource.data`.
    //
    // "anyone" requires no workspace/project relationship at all — that
    // IS the point of that visibility level, matching an unauthenticated
    // Google Sheets link. "organization" requires real workspace
    // membership (isWorkspaceMember, which itself requires isSignedIn())
    // but explicitly bypasses project membership, since the whole point
    // of this feature is reaching a file without being added to its
    // project.
    function isSharedFile(fileData) {
      return 'shareSettings' in fileData
        && fileData.shareSettings != null
        && (
          fileData.shareSettings.visibility == 'anyone'
          || (fileData.shareSettings.visibility == 'organization' && isWorkspaceMember(fileData.workspaceId))
        );
    }

    // The write gate for a shared-link visitor: everything isSharedFile
    // already requires, PLUS the file owner must have explicitly picked
    // "Commenter" (not "Viewer"), PLUS the visitor must be signed in
    // (real account OR Firebase Anonymous Auth — see lib/firebase/auth's
    // signInGuest) as a basic anti-abuse floor even under "anyone".
    function canCommentOnSharedFile(fileData) {
      return isSignedIn() && isSharedFile(fileData) && fileData.shareSettings.permission == 'comment';
    }

    match /users/{uid} {
      // Super Admin can read any profile (Super Admin > Users, and
      // isSuperAdmin() itself reading its OWN doc). `platformRole` is
      // otherwise the one field on this doc a client can NEVER set or
      // change, on create OR update — even the doc's own owner. Only
      // firebase-admin (verifySuperAdminAuth's self-healing bootstrap)
      // ever writes it, which is what makes isSuperAdmin() above safe
      // to trust. `.get('platformRole', null)` on both sides handles
      // the field being absent entirely (every normal user).
      allow read: if isSelf(uid) || isSuperAdmin();
      allow create: if isSelf(uid) && request.resource.data.get('platformRole', null) == null;
      allow update: if isSelf(uid)
        && request.resource.data.get('platformRole', null) == resource.data.get('platformRole', null);
      allow delete: if isSelf(uid);
    }

    // Minimal-data slug registry — see WorkspaceSlug's doc comment in
    // types/workspace.types.ts for why this exists separately from
    // `workspaces`. Any signed-in user may read (checking availability
    // must work for someone who isn't a member of ANY workspace yet)
    // and create (reserving a slug while creating their own new
    // workspace) — but never update or delete, so a slug can't be
    // reassigned or squatted-then-freed once claimed. `create` only
    // succeeds if the document doesn't already exist (Firestore's
    // create-vs-update distinction), which is what actually enforces
    // uniqueness — a second attempt at the same slug hits `update`
    // (since the doc now exists) and is rejected.
    match /workspace_slugs/{slug} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.slug == slug;
      allow update, delete: if false;
    }

    // See FileShareLookup's doc comment in types/file.types.ts — a tiny
    // ID-keyed routing doc (never the file content itself) the public
    // /share/[shareToken] page resolves BEFORE it knows which workspace/
    // project/file a token even belongs to. `isSignedIn()` (not
    // `isSuperAdmin()`/membership — this collection has no such concept)
    // is the read gate: the share page signs the visitor in anonymously
    // first (see lib/firebase/auth's signInGuest) even for "anyone"-mode
    // links with no visible sign-in form, so this still requires SOME
    // real Firebase Auth credential rather than a fully open `if true` —
    // no collection in this app has ever needed that, and this one
    // doesn't either. Knowing fileId/workspaceId/projectId alone grants
    // nothing further — every other collection's real rules still apply
    // in full (see isSharedFile() on `files` itself).
    match /file_shares/{shareToken} {
      allow read: if isSignedIn();
      allow create, update: if canWriteProject(request.resource.data.workspaceId, request.resource.data.projectId);
      allow delete: if canWriteProject(resource.data.workspaceId, resource.data.projectId);
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      allow create: if isSignedIn();
      // Profile fields (name, logo, timezone, ...) are editable by
      // owner OR admin, matching every other "manage this workspace"
      // action in this app (settings, members, roles). Deleting the
      // whole workspace is owner OR Super Admin — see Settings > All
      // Workspaces (Super-Admin-only), where an admin can act on a
      // workspace they don't personally belong to. Still real deletion
      // (see deleteWorkspaceAccess in workspaceService.ts), not
      // frontend-hidden — this is the actual enforcement.
      allow update: if isWorkspaceMemberWithRole(workspaceId, ['owner', 'admin']);
      allow delete: if isWorkspaceOwner(workspaceId) || isSuperAdmin();

      match /activity_logs/{logId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update, delete: if false;
      }

      match /notifications/{uid}/items/{itemId} {
        allow read, write: if isSelf(uid);
      }

      // See WorkspaceSubscription's doc comment in billing.types.ts —
      // the source of truth for what this workspace is entitled to.
      // Write is UNCONDITIONALLY denied to every client, including the
      // workspace's own owner — "never trust plan=business sent from
      // the browser" (Section 9/23 of the subscription-system spec).
      // Only firebase-admin (billingAdmin.ts, called from
      // /api/billing/checkout, /change-plan, /webhook,
      // /activate-plan, /activate-enterprise — every one of which
      // independently re-verifies who's asking before writing) may
      // ever touch this doc; it bypasses rules entirely, so this
      // `false` never blocks those routes, only direct client access.
      match /billing/subscription {
        allow read: if isWorkspaceMemberWithRole(workspaceId, ['owner', 'admin']) || isSuperAdmin();
        allow write: if false;
      }
    }

    // Super Admin > Billing's cross-workspace listing (see
    // allWorkspaceSubscriptionsQuery's doc comment in
    // lib/firebase/firestore.ts) — a `collectionGroup('billing')` query
    // is a SEPARATE thing from the nested `workspaces/{workspaceId}/
    // billing/subscription` match above as far as rules evaluation is
    // concerned: that nested rule only ever applies to a get/query
    // scoped to one specific workspace, never to a collection-group
    // query spanning all of them. This `{path=**}` wildcard match is
    // what actually authorizes the collection-group read itself.
    match /{path=**}/billing/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // See SalesLead's doc comment in billing.types.ts. `create` is
    // denied to every client (including a signed-in one) — the public
    // Contact Sales form has no account to be authorized by, so lead
    // creation goes ONLY through POST /api/sales-leads (firebase-admin,
    // bypasses this rule entirely, does its own field validation).
    // Reading and updating status (Settings > Sales Leads) IS a direct
    // client operation, gated by isSuperAdmin() — the same single
    // designated account every other cross-workspace admin view in
    // this app already trusts, not a new admin/auth concept.
    match /sales_leads/{leadId} {
      allow read, update: if isSuperAdmin();
      allow create, delete: if false;
    }

    // Platform-wide Super Admin action trail (Super Admin > Audit
    // Logs) — see PlatformAuditLogEntry's doc comment in
    // platformAudit.types.ts. Admin-SDK-write-only (every entry is
    // written by logPlatformAudit from a route already gated by
    // verifySuperAdminAuth); Super Admin can read, nobody else can.
    match /platform_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /members/{memberId} {
      allow read: if isSignedIn();

      // INITIAL OWNER BOOTSTRAP ONLY. A brand-new workspace has no
      // members yet, so a normal "must already be a member to write
      // membership" check can never be satisfied by its own first
      // membership doc — that's the chicken-and-egg problem. Instead
      // of falling back to "any signed-in user may create any
      // membership doc" (too broad), this verifies three things
      // together: (1) request.resource.data.userId ==
      // request.auth.uid — nobody can bootstrap a membership for
      // someone else; (2) request.resource.data.role == 'owner' —
      // nobody can self-assign admin/member and skip a real invite
      // flow; (3) the referenced workspace's `ownerId` (already
      // committed at this point — workspaceService.createWorkspace
      // writes workspaces/{id} BEFORE members/{id}, sequentially,
      // specifically so this get() sees committed data, not an
      // in-flight write) equals the caller — proving they're that
      // workspace's rightful creator, not an arbitrary signed-in
      // user. A normal member can never satisfy all three for a
      // workspace they don't own.
      //
      // A second path exists below for INVITE ACCEPT — a signed-in
      // user creating their OWN membership (never someone else's) by
      // accepting a real pending invite addressed to them. See
      // isValidInviteAccept above.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          (request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.ownerId == request.auth.uid)
          || (request.resource.data.role != 'owner' && isValidInviteAccept(request.resource.data))
        );

      // Admin can manage (change role, remove) any member EXCEPT the
      // owner's own doc, and can never grant/hold the 'owner' role
      // itself — closes off privilege escalation (an admin demoting,
      // deleting, or overwriting the actual owner, or promoting
      // someone — including themselves — to owner). Only the real
      // owner can touch an owner-role doc or hand out 'owner'.
      allow update: if isWorkspaceOwner(resource.data.workspaceId)
        || (isWorkspaceMemberWithRole(resource.data.workspaceId, ['admin'])
          && resource.data.role != 'owner'
          && request.resource.data.role != 'owner');
      // isSuperAdmin() added alongside the existing owner/admin paths so
      // deleteWorkspaceAccess (see workspaceService.ts) can also remove
      // every member doc — including the workspace's own owner's —
      // when Super Admin deletes a workspace it doesn't personally
      // belong to from Settings > All Workspaces.
      allow delete: if isWorkspaceOwner(resource.data.workspaceId)
        || (isWorkspaceMemberWithRole(resource.data.workspaceId, ['admin']) && resource.data.role != 'owner')
        || isSuperAdmin();
    }

    match /settings/{workspaceId} {
      // Branding (logo/favicon/backgrounds/colors) lives on this same
      // doc (settings.branding) — isSuperAdmin() added to both read
      // and update so the designated Super Admin account can view and
      // manage any workspace's branding, not just workspaces it's
      // actually a member of, per the project-access model's global
      // Super Admin grant (see the isSuperAdmin() function above).
      allow read: if isWorkspaceMember(workspaceId) || isSuperAdmin();
      // CREATE happens inside workspaceService.createWorkspace()'s
      // transaction, in the same transaction that creates the
      // workspaces/{workspaceId} doc itself — a rule that does
      // get() on that sibling doc (isWorkspaceOwner) is not
      // reliably evaluable there (the doc isn't guaranteed visible
      // to rule evaluation within its own creating transaction, a
      // known Firestore gotcha). Ownership at creation time is
      // instead established by the self-consistency check below
      // (the new doc's own workspaceId field must match the path).
      // UPDATE is owner OR admin — this doc is every Settings
      // sub-page's save target (Branding, Workspace profile, AI,
      // Theme, ...), and the client already treats admin as able to
      // manage all of those (canManageWorkspace) — requiring literal
      // ownership here silently blocked every admin's save with a
      // permission-denied error the UI could only surface as a toast.
      // DELETE is owner or Super Admin — deleteWorkspaceAccess removes
      // this doc as part of a full workspace deletion (see above).
      allow create: if isSignedIn() && request.resource.data.workspaceId == workspaceId;
      allow update: if isWorkspaceMemberWithRole(workspaceId, ['owner', 'admin']) || isSuperAdmin();
      allow delete: if isWorkspaceOwner(workspaceId) || isSuperAdmin();
    }

    // Projects are a top-level collection carrying a `workspaceId`
    // field (see lib/firebase/firestore.ts). Every rule below re-checks
    // that field so a request can never read/write a project outside
    // the caller's own workspace, independent of query-side filters.
    //
    // READ is project-membership-gated (canAccessProject), not just
    // workspace membership — this is the core of the project-access
    // model: belonging to a workspace no longer implies visibility
    // into every project in it. CREATE stays workspace-level (any
    // non-viewer workspace member can start a new project — the
    // CREATOR then becomes that project's own first project_members
    // record via projectService.createProject, never every workspace
    // member automatically). UPDATE/DELETE are tightened from "any
    // workspace member" to canManageProject (project-level or
    // workspace-level owner/admin, or Super Admin).
    match /projects/{projectId} {
      allow read: if canAccessProject(resource.data.workspaceId, projectId);
      // Restricted to owner/admin/member — a viewer can see projects
      // but not create them. (No "manager" role exists in this app's
      // model; using the real MemberRole enum rather than inventing one.)
      allow create: if isWorkspaceMemberWithRole(request.resource.data.workspaceId, ['owner', 'admin', 'member']);
      allow update: if canManageProject(resource.data.workspaceId, projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if canManageProject(resource.data.workspaceId, projectId);
    }

    // Real, queryable project-level access-control records — see
    // ProjectMembership's doc comment in types/project.types.ts. Doc
    // id is `${projectId}_${uid}`; membershipId.split('_') recovers
    // both parts even when the doc doesn't exist yet (needed for
    // create, and for a self-read that correctly resolves to "no
    // membership" instead of erroring).
    match /project_members/{membershipId} {
      // Firestore does NOT filter query results against security
      // rules — for a `list` (query) request, it statically checks
      // whether the rule is PROVABLY satisfied using only the fields
      // the query itself filters on. useAccessibleProjectIds.ts (the
      // shared resolver behind the Projects page, My Tasks, Files,
      // Reviews, and Calendar for every non-admin user) runs
      // `where("workspaceId","==",X).where("uid","==",myUid)` — so the
      // rule MUST include a clause written in terms of
      // `resource.data.uid`, not just the document id, or Firestore
      // rejects the entire query with "Missing or insufficient
      // permissions" before it ever runs, even though every document
      // it would have returned genuinely belongs to the caller. This
      // was the actual bug: the self-access clause below used to be
      // `membershipId.split('_')[1] == request.auth.uid` only — correct
      // for a direct `get()` by id (still kept, for the "does this
      // exact project_id_uid doc exist" case used elsewhere), but
      // invisible to Firestore's query-compatibility check, since it
      // doesn't reference a queried field at all.
      // Clause order matters here, not just content: `resource.data.*`
      // must never be reached when `resource` could be null (a get()
      // on a project_members doc that doesn't exist yet — e.g. an
      // employee who hasn't been added to this project — must resolve
      // to "no access", not a rules-evaluation error). The doc-id
      // clause and isSuperAdmin() are evaluated first because neither
      // touches `resource`; every clause that reads `resource.data` is
      // explicitly guarded with `resource != null &&` so `||`'s
      // short-circuit never lets a null-dereference throw.
      // A workspace/project admin ADDING a brand-new member needs to
      // read this doc BEFORE it exists (projectService.upsertProjectMembership
      // does a getDoc() first, to decide whether to preserve an
      // existing addedAt) — the two `resource != null`-guarded clauses
      // above can never authorize that, since resource IS null for a
      // membership that doesn't exist yet. Without this clause, adding
      // a genuinely NEW member throws permission-denied on that
      // pre-check, silently failing to create the real access-control
      // record even though the (separate, unprotected) embedded
      // Project.members[] array write right before it already
      // succeeded — exactly the "added but still can't see the
      // project" bug. This clause depends only on the projects
      // collection (which always exists once a project is created)
      // and the membershipId's own path segments, so it works whether
      // or not the project_members doc itself exists yet.
      function targetProjectWorkspaceId() {
        return get(/databases/$(database)/documents/projects/$(membershipId.split('_')[0])).data.workspaceId;
      }

      allow read: if isSignedIn() && (
        membershipId.split('_')[1] == request.auth.uid
        || isSuperAdmin()
        || (resource != null && resource.data.uid == request.auth.uid)
        || (resource != null && isWorkspaceMemberWithRole(resource.data.workspaceId, ['owner', 'admin']))
        || canManageProject(targetProjectWorkspaceId(), membershipId.split('_')[0])
      );

      // Only someone who can already MANAGE the target project
      // (workspace owner/admin, Super Admin, or that project's own
      // owner/admin) may add a member — never the invitee themselves
      // (closes Scenario C: a user granting themselves access to a
      // project they're not authorized on). The target uid must
      // already be a member of the SAME workspace the project belongs
      // to (never an arbitrary user, never cross-workspace), and the
      // doc's own workspaceId/projectId/uid must be internally
      // consistent with its own document id.
      allow create: if (
          // BOOTSTRAP ONLY: the project's own creator claiming their
          // OWN owner-role membership record immediately after
          // creating the project itself (see
          // projectService.createProject/duplicateProject, which
          // write the project doc BEFORE this, sequentially, so this
          // get() sees committed data). Mirrors the same pattern the
          // `members` collection above uses for the analogous
          // workspace-owner bootstrap problem. Nobody can self-assign
          // 'owner' here unless the project doc already says they are
          // its real owner.
          (request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == request.auth.uid)
          || canManageProject(request.resource.data.workspaceId, request.resource.data.projectId)
        )
        && request.resource.data.projectId == membershipId.split('_')[0]
        && request.resource.data.uid == membershipId.split('_')[1]
        && isWorkspaceMember(request.resource.data.workspaceId)
        && exists(/databases/$(database)/documents/members/$(request.resource.data.workspaceId + '_' + request.resource.data.uid))
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.workspaceId == request.resource.data.workspaceId;

      allow update: if canManageProject(resource.data.workspaceId, resource.data.projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.uid == resource.data.uid;

      allow delete: if canManageProject(resource.data.workspaceId, resource.data.projectId);
    }

    // Tasks mirror the `projects` access shape — project-membership-
    // gated. useTasks.ts / useCalendarTasks.ts's workspace-wide "My
    // Tasks"/Calendar views (no explicit projectId) now pre-filter
    // their OWN query to the caller's accessible project ids first
    // (see useAccessibleProjectIds.ts) for anyone who isn't a
    // workspace owner/admin/Super Admin — so every task a query like
    // that could possibly return already belongs to a project this
    // rule will allow, and Firestore's "reject the whole query if any
    // matched doc fails the rule" behavior never trips. Comments/
    // attachments/activity are subcollections, so membership is re-
    // checked via get() on the parent task rather than duplicating a
    // workspaceId/projectId field on every subdocument.
    match /tasks/{taskId} {
      allow read: if canAccessProject(resource.data.workspaceId, resource.data.projectId);
      allow create: if canWriteProject(request.resource.data.workspaceId, request.resource.data.projectId);
      allow update: if canWriteProject(resource.data.workspaceId, resource.data.projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if canWriteProject(resource.data.workspaceId, resource.data.projectId);

      function isParentTaskMember() {
        let parent = get(/databases/$(database)/documents/tasks/$(taskId)).data;
        return canAccessProject(parent.workspaceId, parent.projectId);
      }

      match /comments/{commentId} {
        allow read, create: if isParentTaskMember();
        allow update, delete: if isParentTaskMember()
          && (resource.data.authorId == request.auth.uid || resource == null);
      }

      match /attachments/{attachmentId} {
        allow read, create, update: if isParentTaskMember();
        allow delete: if isParentTaskMember();
      }

      match /activity/{activityId} {
        allow read, create: if isParentTaskMember();
        allow update, delete: if false;
      }
    }

    // Boards mirror the projects/tasks access shape. board_columns and
    // board_preferences carry their own `workspaceId` field (rather than
    // requiring a join through the parent board) so they can be
    // queried and rule-checked directly.
    match /boards/{boardId} {
      allow read: if canAccessProject(resource.data.workspaceId, resource.data.projectId);
      allow create: if canWriteProject(request.resource.data.workspaceId, request.resource.data.projectId);
      allow update: if canWriteProject(resource.data.workspaceId, resource.data.projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if canWriteProject(resource.data.workspaceId, resource.data.projectId);

      match /activity/{activityId} {
        function parentBoard() {
          return get(/databases/$(database)/documents/boards/$(boardId)).data;
        }
        allow read, create: if canAccessProject(parentBoard().workspaceId, parentBoard().projectId);
        allow update, delete: if false;
      }
    }

    // board_columns only carries `boardId`+`workspaceId` (no direct
    // projectId — see board.types.ts), so project access is checked
    // via the parent board doc.
    match /board_columns/{columnId} {
      function parentBoardOf(boardId) {
        return get(/databases/$(database)/documents/boards/$(boardId)).data;
      }
      allow read: if canAccessProject(resource.data.workspaceId, parentBoardOf(resource.data.boardId).projectId);
      allow create: if canWriteProject(request.resource.data.workspaceId, parentBoardOf(request.resource.data.boardId).projectId);
      allow update: if canWriteProject(resource.data.workspaceId, parentBoardOf(resource.data.boardId).projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if canWriteProject(resource.data.workspaceId, parentBoardOf(resource.data.boardId).projectId);
    }

    // Preferences are personal: any workspace member can read them
    // (needed to resolve `${boardId}_${uid}` docs while listing), but
    // only the owning user can write their own.
    match /board_preferences/{preferenceId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Files back the Files module AND the Creative Workspace — same
    // collection, same rule, per creative-studio/[projectId]'s "one
    // source of truth" requirement. Project-membership-gated, same as
    // `tasks` above — useFiles.ts's workspace-wide view pre-filters by
    // accessible project ids for anyone who isn't workspace owner/
    // admin/Super Admin (see useAccessibleProjectIds.ts). Comments are
    // a subcollection scoped to their parent file's workspace
    // (isParentFileMember), mirroring tasks/{taskId}/comments above;
    // only the comment's own author may edit/delete it (or resolve it
    // — resolving is treated as an update any project member may
    // make, since reviewers resolving someone else's comment is normal
    // review workflow).
    match /files/{fileId} {
      // isSharedFile lets a link-sharing visitor (organization or anyone —
      // see FileShareSettings) open THIS file without project membership;
      // it never appears in create/update/delete below — sharing only
      // ever grants reading the file + commenting on it, never editing
      // the file record itself (that stays canWriteProject-gated, same as
      // always, so only a real project member/admin can toggle sharing
      // on/off in the first place).
      allow read: if canAccessProject(resource.data.workspaceId, resource.data.projectId) || isSharedFile(resource.data);
      allow create: if canWriteProject(request.resource.data.workspaceId, request.resource.data.projectId);
      allow update: if canWriteProject(resource.data.workspaceId, resource.data.projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if canWriteProject(resource.data.workspaceId, resource.data.projectId);

      function isParentFileMember() {
        let parent = get(/databases/$(database)/documents/files/$(fileId)).data;
        return canAccessProject(parent.workspaceId, parent.projectId);
      }

      // Broader than isParentFileMember above: also true for a
      // link-sharing visitor who can merely VIEW the file (any
      // visibility level, regardless of permission) — used for read only.
      function isParentFileReadable() {
        let parent = get(/databases/$(database)/documents/files/$(fileId)).data;
        return canAccessProject(parent.workspaceId, parent.projectId) || isSharedFile(parent);
      }

      // Used for create only: a real project member with write access,
      // OR a link-sharing visitor whose file is specifically shared with
      // "Commenter" (not "Viewer") permission.
      function canCreateOnParentFile() {
        let parent = get(/databases/$(database)/documents/files/$(fileId)).data;
        return canWriteProject(parent.workspaceId, parent.projectId) || canCommentOnSharedFile(parent);
      }

      match /comments/{commentId} {
        allow read: if isParentFileReadable();
        allow create: if canCreateOnParentFile();
        // Resolving/editing an EXISTING comment stays real-membership-only
        // (isParentFileMember, no shared-link fallback) — a link visitor
        // can add their own feedback but shouldn't get to resolve or
        // rewrite anyone's comment thread.
        allow update: if isParentFileMember();
        // Deleting your OWN comment is allowed for anyone who can read the
        // thread at all (member or shared visitor) — undoing your own
        // mistake isn't a moderation action the way resolving is.
        allow delete: if isParentFileReadable()
          && (resource.data.authorId == request.auth.uid);
      }

      // Drawn annotations (circle/rectangle/arrow/freehand/text) on
      // the review canvas — sibling to comments, same read/create/
      // author-only-write split as above.
      match /annotations/{annotationId} {
        allow read: if isParentFileReadable();
        allow create: if canCreateOnParentFile();
        allow update, delete: if isParentFileReadable()
          && (resource.data.authorId == request.auth.uid);
      }
    }

    // Any project member can REQUEST a review (create), but deciding
    // one (the only thing `update` is ever used for — see
    // reviewService.decideReview, which is the sole updateDoc() call
    // against this collection) is restricted to workspace owner/admin
    // or a project-level owner/manager (canManageProject) — a plain
    // editor/viewer can't approve their own — or anyone's — review by
    // calling the SDK directly, bypassing the UI check. Project-
    // membership-gated, same as `tasks`/`files` above — useReviews.ts's
    // workspace-wide view pre-filters by accessible project ids for
    // anyone who isn't workspace owner/admin/Super Admin.
    match /reviews/{reviewId} {
      allow read: if canAccessProject(resource.data.workspaceId, resource.data.projectId);
      allow create: if canWriteProject(request.resource.data.workspaceId, request.resource.data.projectId);
      allow update: if canManageProject(resource.data.workspaceId, resource.data.projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if canWriteProject(resource.data.workspaceId, resource.data.projectId);
    }

    // Creative Stages — same top-level-collection-with-workspaceId(+projectId)
    // access shape as files/reviews/tasks (see stage.types.ts for why
    // this isn't nested under a projects/{id} doc).
    match /stages/{stageId} {
      allow read: if canAccessProject(resource.data.workspaceId, resource.data.projectId);
      allow create: if canWriteProject(request.resource.data.workspaceId, request.resource.data.projectId);
      allow update: if canWriteProject(resource.data.workspaceId, resource.data.projectId)
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if canWriteProject(resource.data.workspaceId, resource.data.projectId);
    }

    // Only owner/admin may create, update (resend/cancel), or delete
    // invites — this used to allow ANY member, which let a plain
    // member invite people or cancel/rewrite someone else's invite.
    // An invitee who isn't a workspace member yet can still read and
    // accept only the specific invite(s) addressed to their own
    // verified auth email (see the read/update OR-clauses below) —
    // that's how a brand-new user goes from "holds an invite link" to
    // "is a real member" without ever needing broader access.
    match /workspace_invites/{inviteId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId)
        || (isSignedIn() && resource.data.email == request.auth.token.email);

      // role is restricted to non-owner so an inviter can never grant
      // Owner (or anything else) via an invite; workspaceId is
      // re-checked against the caller's OWN membership so an
      // owner/admin of workspace A can never create an invite that
      // claims to belong to workspace B.
      allow create: if isWorkspaceMemberWithRole(request.resource.data.workspaceId, ['owner', 'admin'])
        && request.resource.data.role in ['admin', 'member', 'viewer'];

      // Either an owner/admin managing the invite (resend/cancel), or
      // the invitee themselves accepting it — which may ONLY flip
      // status pending -> accepted and can never change which
      // workspace/email/role the invite actually grants.
      allow update: if isWorkspaceMemberWithRole(resource.data.workspaceId, ['owner', 'admin'])
        || (isSignedIn()
          && resource.data.email == request.auth.token.email
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role);

      allow delete: if isWorkspaceMemberWithRole(resource.data.workspaceId, ['owner', 'admin']);
    }

    // Custom-role definitions gate real permissions (see the Access
    // Control settings page) — only owner/admin may create/edit/delete
    // one. This used to allow ANY member, meaning a plain member could
    // grant themselves or anyone else elevated permissions by editing
    // a role's permissions array directly.
    match /workspace_roles/{roleId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMemberWithRole(request.resource.data.workspaceId, ['owner', 'admin']);
      allow update: if isWorkspaceMemberWithRole(resource.data.workspaceId, ['owner', 'admin'])
        && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isWorkspaceMemberWithRole(resource.data.workspaceId, ['owner', 'admin']);
    }

    // Append-only compliance trail: any member can create an entry
    // (actions they themselves take), but nothing can be edited or
    // deleted once written.
    match /audit_logs/{logId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if false;
    }

    // AI Studio generation history — same append-only shape as audit_logs.
    match /ai_usage_logs/{logId} {
      allow read: if isWorkspaceMember(resource.data.workspaceId);
      allow create: if isWorkspaceMember(request.resource.data.workspaceId);
      allow update, delete: if false;
    }

    // A workspace's own encrypted Gemini key (id = workspaceId). Only
    // owner/admin may configure it — a plain member can never write
    // here, matching "normal members cannot configure the API key".
    // Read is open to any workspace member because what's actually
    // readable is AES-256-GCM ciphertext, not the key itself — it's
    // meaningless without SETTINGS_ENCRYPTION_KEY, which lives only in
    // the server process (see lib/server/secretCrypto.ts) and is what
    // the generate/test API routes need to decrypt it server-side on
    // behalf of any member running a generation. A member "reading"
    // this doc never recovers the real key from it.
    // Doc id is `${workspaceId}_${provider}` (one key per provider per
    // workspace, e.g. a Gemini key and an NVIDIA key at once). Most
    // reads here are for a key that hasn't been configured YET (the
    // doc doesn't exist), and `get()`ing a nonexistent doc makes
    // `resource` null — so `resource.data.workspaceId` would throw
    // and deny every such read. Deriving workspaceId from the doc id
    // itself (`${workspaceId}_${provider}`, neither of which ever
    // contains "_") sidesteps that: it's path data, always available
    // whether or not the document exists.
    match /ai_config/{configId} {
      allow read: if isWorkspaceMember(configId.split('_')[0]);
      allow create, update: if isWorkspaceMemberWithRole(request.resource.data.workspaceId, ['owner', 'admin'])
        && request.resource.data.workspaceId == configId.split('_')[0];
      allow delete: if isWorkspaceMemberWithRole(configId.split('_')[0], ['owner', 'admin']);
    }

    // A user's connected Gmail account (OAuth refresh token,
    // encrypted — see gmail.types.ts) used to send workspace-invite
    // emails from their own address. Deliberately denies ALL direct
    // client access, in both directions: this doc is read/written
    // exclusively by server routes (src/app/api/auth/google/*,
    // /api/invites/send) via firebase-admin, which bypasses these
    // rules entirely and independently verifies the caller's Firebase
    // ID token before touching a UID's doc. The explicit `if false`
    // here is defense-in-depth/self-documentation, not the real gate.
    match /gmail_connections/{uid} {
      allow read, write: if false;
    }
  }
}
